# Comma-separated browser origins allowed to call this service directly.
# When the Next.js proxy is the only caller, the frontend origin is enough.
ALLOWED_ORIGINS=http://localhost:3000

# Optional overrides (defaults shown)
# TTS_MAX_CHARS=40000          # ~40 minutes of speech
# TTS_CHUNK_CHARS=500          # characters per parallel synthesis chunk
# TTS_FIRST_CHUNK_CHARS=300    # small first chunk -> fast first byte
# TTS_CONCURRENCY=10           # parallel chunks per request
# TTS_GLOBAL_CONCURRENCY=24    # parallel chunks across all requests
# TTS_CHUNK_RETRIES=3
# LOG_LEVEL=INFO
