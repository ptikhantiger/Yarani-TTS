# URL of the FastAPI edge-tts microservice (server-side only, never exposed to the browser).
TTS_BACKEND_URL=http://127.0.0.1:8010

# Link shown in the navbar.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ptikhantiger/Yarani-TTS

# Optional: call the FastAPI service directly from the browser instead of via the
# Next.js proxy. Sidesteps serverless function time limits for very long texts.
# The backend must list this site's origin in ALLOWED_ORIGINS.
# NEXT_PUBLIC_TTS_API_URL=https://your-backend.onrender.com
